{
  "name": "rin-blog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"bun run dev:server\" \"bun run dev:client\"",
    "dev:client": "cd client && bunx --bun vite",
    "dev:server": "cd server && bun run dev:remote",
    "dev:cron": "bun wrangler dev --port 11498 --test-scheduled",
    "check": "turbo check",
    "build": "turbo build",
    "cf:deploy": "npm run _prepareDeploy && wrangler deploy",
    "_prepareDeploy": "cd client && npm run check && bun run build:skip-check",
    "preview": "wrangler pages dev --d1=DB:rin client/dist --port 11498",
    "pages:deploy": "bunx wrangler pages deploy client/dist --project-name rin",
    "d1": "wrangler d1",
    "r2": "wrangler r2",
    "db:generate": "drizzle-kit generate --config=server/drizzle.config.ts",
    "db:introspect": "drizzle-kit introspect --config=server/drizzle.config.ts",
    "db:push": "drizzle-kit push --config=server/drizzle.config.ts",
    "db:migrate": "bun scripts/dev-migrator.ts",
    "db:migrate-images": "bun scripts/migrate-images.ts",
    "cf-deploy": "bun scripts/migrator.ts",
    "b": "bun --filter './client' build:skip-check",
    "t": "turbo t",
    "g": "turbo run g",
    "m": "bun scripts/dev-migrator.ts",
    "i18n": "bun --filter './client' i18n",
    "clean": "rm -rf dist node_modules client/node_modules server/node_modules",
    "format:check": "turbo format:check",
    "format:write": "turbo format:write"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.9",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.26.0",
    "@libsql/client": "^0.15.7",
    "@loadable/component": "^5.16.4",
    "@types/loadable__component": "^5.13.9",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.1.2",
    "dotenv": "^16.5.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "i18next-parser": "^9.0.0",
    "postcss": "^8.4.38",
    "prettier": "^3.5.3",
    "puppeteer": "^22.13.0",
    "tailwindcss": "^3.4.3",
    "turbo": "latest",
    "vitest": "1.6.1"
  },
  "dependencies": {
    "@types/lodash": "^4.17.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "fast-xml-parser": "^4.4.0",
    "html-to-md": "^0.8.5",
    "i18next": "^25.2.0",
    "i18next-browser-languagedetector": "^8.1.0",
    "i18next-http-backend": "^3.0.2",
    "lodash": "^4.17.21",
    "mermaid": "^10.9.1",
    "react-i18next": "^15.5.1",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.5.0",
    "rehype-katex": "^7.0.0",
    "rehype-mathjax": "^6.0.0",
    "rehype-parse": "^9.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-react": "^8.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-rehype": "^11.1.0",
    "sqlite3": "^5.1.7"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.1.9"
}
